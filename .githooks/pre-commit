#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-commit - Git pre-commit hook for TFF2
# Checks formatting of staged C/C++ files and validates YAML schemas before commit.
# ==============================================================================
set -euo pipefail

COLOR_RESET="\033[0m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_RED="\033[1;31m"
COLOR_BLUE="\033[1;34m"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

# Retrieve all staged files (Added, Copied, Modified, Renamed)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [[ -z "${STAGED_FILES}" ]]; then
    exit 0
fi

FAILED=0

# 1. Check C/C++ code formatting with clang-format
STAGED_CPP=()
while IFS= read -r file; do
    if [[ "$file" =~ \.(cpp|h|c)$ ]]; then
        STAGED_CPP+=("$file")
    fi
done <<< "${STAGED_FILES}"

if [[ ${#STAGED_CPP[@]} -gt 0 ]]; then
    CLANG_FORMAT_BIN=""
    for candidate in clang-format clang-format-18 clang-format-17 clang-format-16 clang-format-15 clang-format-14 "${HOME}/.local/bin/clang-format"; do
        if command -v "$candidate" &>/dev/null; then
            CLANG_FORMAT_BIN="$candidate"
            break
        fi
    done

    if [[ -z "${CLANG_FORMAT_BIN}" ]]; then
        echo -e "${COLOR_YELLOW}! Warning: clang-format not found on PATH. Skipping staged C++ formatting check.${COLOR_RESET}"
    else
        for f in "${STAGED_CPP[@]}"; do
            if [[ -f "$f" ]]; then
                if ! "${CLANG_FORMAT_BIN}" --dry-run --Werror "$f" &>/dev/null; then
                    echo -e "${COLOR_RED}✗ Format check failed: $f${COLOR_RESET}"
                    echo -e "  Fix with: ${CLANG_FORMAT_BIN} -i \"$f\" && git add \"$f\""
                    echo -e "  Or: cmake --build build --target format && git add \"$f\""
                    FAILED=1
                fi
            fi
        done
    fi
fi

# 2. Check YAML syntax and schema validation
STAGED_YAML=()
while IFS= read -r file; do
    if [[ "$file" =~ \.(yaml|yml)$ ]]; then
        STAGED_YAML+=("$file")
    fi
done <<< "${STAGED_FILES}"

if [[ ${#STAGED_YAML[@]} -gt 0 ]]; then
    VALIDATE_SCRIPT="${REPO_ROOT}/scripts/validate_yaml.py"
    if [[ -x "${VALIDATE_SCRIPT}" || -f "${VALIDATE_SCRIPT}" ]]; then
        for f in "${STAGED_YAML[@]}"; do
            if [[ -f "$f" ]]; then
                if ! python3 "${VALIDATE_SCRIPT}" "$f"; then
                    echo -e "${COLOR_RED}✗ YAML validation failed: $f${COLOR_RESET}"
                    FAILED=1
                fi
                # If tff_linux binary exists and it's a TFF config, run tff validate
                if [[ -x "${REPO_ROOT}/build/tff_linux" && ("$f" =~ ^config/ || "$f" =~ tff) ]]; then
                    if ! "${REPO_ROOT}/build/tff_linux" validate "$f" &>/dev/null; then
                        echo -e "${COLOR_RED}✗ TFF engine validation failed: $f${COLOR_RESET}"
                        FAILED=1
                    fi
                fi
            fi
        done
    fi
fi

# 3. Check JSON schema validity if schema file is staged
if echo "${STAGED_FILES}" | grep -q "schema/tff-schema.json"; then
    if [[ -f "schema/tff-schema.json" ]]; then
        if ! python3 -m json.tool schema/tff-schema.json >/dev/null 2>&1; then
            echo -e "${COLOR_RED}✗ Invalid JSON in schema/tff-schema.json${COLOR_RESET}"
            FAILED=1
        fi
    fi
fi

if [[ $FAILED -ne 0 ]]; then
    echo -e "\n${COLOR_RED}Pre-commit checks failed! Commit aborted.${COLOR_RESET}"
    echo -e "Fix the issues above or bypass temporarily with: git commit --no-verify\n"
    exit 1
fi

echo -e "${COLOR_GREEN}✓ Pre-commit checks passed.${COLOR_RESET}"
exit 0
